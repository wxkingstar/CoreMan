# 镜像标签，升级时修改
COREMAN_IMAGE_TAG=dev
# 数据库
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://coreman:change-me@postgres:5432/coreman
# 对外 HTTPS 根地址（OAuth 回调、会话链接）
# 必须是对外可达的完整 origin（协议+域名+端口，与 CADDY_HTTP_PORT 一致），企微回调与登录 redirect_uri 原样使用它
PUBLIC_BASE_URL=http://localhost
# 32 字节 base64，生成：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=
# 管理台会话 cookie 签名密钥（≥16 字符随机串）
SESSION_SECRET=
# 首次部署的引导管理员；平台登录可用后在设置里关闭
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
# 可选
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
RELAY_NETWORK_MODE=bridge
OBJECT_STORAGE=local
COREMAN_ENV=prod
# Caddy 监听地址：本地 :80；生产填域名如 coreman.example.com（自动 HTTPS）
CADDY_SITE_ADDRESS=:80
# Caddy 在宿主机发布的端口（默认 80/443；被占用时改用如 8080/8443）
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# 可选 S3 附件存储。保持 local 可继续读取本地旧附件；S3 凭据仅由运维配置。
# OBJECT_STORAGE=s3
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=coreman-attachments
# S3_PREFIX=coreman-objects
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_SESSION_TOKEN=
