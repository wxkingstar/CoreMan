# 镜像标签，升级时修改
COREMAN_IMAGE_TAG=dev
# 数据库
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://coreman:change-me@postgres:5432/coreman
# 对外 HTTPS 根地址（OAuth 回调、会话链接）
# 必须是对外可达的完整 origin（协议+域名+端口，与 CADDY_HTTP_PORT 一致），企微回调与登录 redirect_uri 原样使用它
PUBLIC_BASE_URL=http://localhost
# 32 字节 base64，生成：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=
# 管理台会话 cookie 签名密钥（≥16 字符随机串）
SESSION_SECRET=
# 首次部署的引导管理员；平台登录可用后在设置里关闭
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
# 可选
LOG_LEVEL=INFO
OBJECT_STORAGE=local
COREMAN_ENV=prod
# 通讯录定时全量同步间隔（小时，scheduler 执行），0 关闭；默认 24
# CONTACT_SYNC_INTERVAL_HOURS=24
# AI 员工规则文档（AGENTS.md、docs/）每日备份到这个私有 GitHub 仓库（owner/name），令牌只需该仓库的
# Contents 读写权限；任一不配则不备份。见 docs/features/rules-backup.md
# RULES_BACKUP_REPO=
# RULES_BACKUP_TOKEN=
# 飞书群聊旁听的判断服务（OpenAI Decisions API）；不配密钥时机器人不能开启群聊旁听
# OPENAI_API_KEY=
# DECISION_MODEL=gpt-6-luna
# Caddy 监听地址：本地 :80；生产填域名如 coreman.example.com（自动 HTTPS）
CADDY_SITE_ADDRESS=:80
# Caddy 在宿主机发布的端口（默认 80/443；被占用时改用如 8080/8443）
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Caddy 与 API 之间的 edge 网段（API 只信任该网段转发的客户端地址），默认 10.250.250.0/28；
# 与宿主机或其他 Docker 网络冲突时改用其他私有网段
# COREMAN_EDGE_SUBNET=10.250.250.0/28

# 可选 S3 附件存储。保持 local 可继续读取本地旧附件；S3 凭据仅由运维配置。
# OBJECT_STORAGE=s3
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=coreman-attachments
# S3_PREFIX=coreman-objects
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_SESSION_TOKEN=

# 可选：个人助理带文件的写操作在等待审批期间存放附件的临时桶（S3 兼容，与上面的附件存储分开）。
# 桶必须私有，并在桶上配置不超过 7 天的自动清理规则；对象名是随机串，文件本体不加密。
# ASSISTANT_TMP_S3_ENDPOINT=https://s3.example.com
# ASSISTANT_TMP_S3_REGION=us-east-1
# ASSISTANT_TMP_S3_BUCKET=coreman-assistant-tmp
# ASSISTANT_TMP_S3_PREFIX=assistant-approvals
# ASSISTANT_TMP_S3_ACCESS_KEY=
# ASSISTANT_TMP_S3_SECRET_KEY=
# ASSISTANT_TMP_S3_ADDRESSING=virtual

# 可选：沿用已有签发方的 ES256 密钥签发业务系统令牌（BOT_TOKEN_<系统>），
# 已信任该签发方公钥的业务系统无需改动即可验签。私钥、KID、ISSUER 必填，公钥可省略（填了须与私钥配对），启动时校验；
# PEM 可写成单行，换行用字面量 \n。未配置时使用平台自动生成并可轮换的密钥。
# BOT_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# BOT_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# BOT_JWT_KID=example-2024
# BOT_JWT_ISSUER=example-issuer

# 可选：外部业务令牌签发方（API/worker 使用；不会注入 Agent）。详见 docs/business-token-providers.md。
# max_token_ttl_seconds 为该提供方上限；不填则按任务超时申请。builtin 不受此配置影响。
# BUSINESS_TOKEN_PROVIDERS='{"company":{"token_url":"https://identity.example.com/oauth/agent-token","client_id":"coreman-agent","client_secret":"REPLACE_WITH_DEPLOYMENT_SECRET","max_token_ttl_seconds":28800}}'

# 可选：开放匿名只读的操作目录 MCP（POST /api/systems/mcp），供成员本机用自己的令牌直连业务系统。
# 目录不按权限过滤，只在入口限定内网的部署里开启。详见 docs/business-system-catalog.md。
# SYSTEMS_CATALOG_PUBLIC=true

# 可选：数据库凭证加密密钥的标识与轮换。新密文写成 enc:v2:<MASTER_KEY_ID>:...，
# 所有进程必须配同一个 MASTER_KEY_ID；不配时为 k1。
# 轮换 MASTER_KEY 时，把旧密钥按 kid:base64 填进 MASTER_KEYS_PREVIOUS（逗号分隔）即可
# 继续读旧行，无需停机重加密；旧行随各自的下一次写入自然迁移到新密钥。
# MASTER_KEY_ID=k1
# MASTER_KEYS_PREVIOUS=k0:<旧 MASTER_KEY 的 base64>
