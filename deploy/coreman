#!/usr/bin/env bash
# CoreMan 运维脚本：up/down/status/logs/migrate/build/upgrade/rollback。
set -euo pipefail

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
# compose 的 --env-file 按 CWD 解析，服务里的 env_file: 按 --project-directory（=${ROOT}）解析。
# 只有绝对路径能让两者指向同一个文件；导出后 compose 才能插值 ${COREMAN_ENV_FILE:-.env}。
ENV_FILE="${COREMAN_ENV_FILE:-$ROOT/.env}"
case "$ENV_FILE" in /*) ;; *) ENV_FILE="$PWD/$ENV_FILE" ;; esac
export COREMAN_ENV_FILE="$ENV_FILE"
COMPOSE_FILE="$ROOT/deploy/docker-compose.yml"
# 网关不在固定列表里：a/b 两侧按记录的活跃侧拉起其中一侧。
DEFAULT_SERVICES=(postgres api-1 api-2 caddy scheduler worker-a worker-b)
GATEWAY_PLATFORMS=(wecom feishu)
ALL_PROFILES=(--profile standby --profile monitoring --profile tools)
WAIT_TIMEOUT="${COREMAN_WAIT_TIMEOUT:-300}"
TAG_PATTERN='^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$'
# 进入镜像的路径；只有这些路径的未提交改动才让构建标签带 -dirty。
IMAGE_PATHS=(coreman web runtime_daemon migrations deploy pyproject.toml uv.lock alembic.ini README.md LICENSE THIRD_PARTY_NOTICES.md)

# 升级状态不写回含凭证的 .env，放在仓库根目录（或 COREMAN_STATE_DIR）的状态文件里：
#   .coreman-image-tag          最近一次成功完成的 upgrade/rollback 的镜像标签
#   .coreman-image-tag.pending  进行中或失败未收尾的升级目标标签
#   .coreman-gateway-active     各平台网关当前活跃侧（wecom=a / feishu=b）
STATE_DIR="${COREMAN_STATE_DIR:-$ROOT}"
TAG_FILE="$STATE_DIR/.coreman-image-tag"
PENDING_FILE="$STATE_DIR/.coreman-image-tag.pending"
GATEWAY_STATE_FILE="$STATE_DIR/.coreman-gateway-active"

compose() {
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    echo "docker compose $*"
  else
    docker compose --project-directory "$ROOT" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
  fi
}

env_get() { [[ -f "$ENV_FILE" ]] && grep -E "^$1=" "$ENV_FILE" | head -n1 | cut -d= -f2- || true; }

read_first_line() {  # 文件不存在时输出空
  local line=""
  if [[ -f "$1" ]]; then IFS= read -r line < "$1" || true; fi
  printf '%s' "$line"
}

write_state() {  # write_state <file> <content>：先写临时文件再改名，避免半写
  printf '%s\n' "$2" > "$1.tmp"
  mv "$1.tmp" "$1"
}

caddy_base_url() {  # 按 .env 的 CADDY_HTTP_PORT 生成访问地址；80 时不带端口
  local port
  port="$(env_get CADDY_HTTP_PORT)"
  port="${port:-80}"
  if [[ "$port" == "80" ]]; then echo "http://localhost"; else echo "http://localhost:${port}"; fi
}

# 显式环境变量优先，其次是记录的部署标签，最后由 compose 读取 .env 的 COREMAN_IMAGE_TAG。
EXPLICIT_IMAGE_TAG="${COREMAN_IMAGE_TAG:-}"
DEPLOYED_TAG="$(read_first_line "$TAG_FILE")"
if [[ -z "$EXPLICIT_IMAGE_TAG" && -n "$DEPLOYED_TAG" ]]; then
  export COREMAN_IMAGE_TAG="$DEPLOYED_TAG"
fi

current_tag() {
  local tag="${COREMAN_IMAGE_TAG:-}"
  [[ -n "$tag" ]] || tag="$(env_get COREMAN_IMAGE_TAG)"
  echo "${tag:-dev}"
}

env_set() {  # env_set KEY VALUE：存在则替换，不存在则追加（用 python 避免 sed 跨平台差异）
  if [[ ! -f "$ENV_FILE" ]]; then
    echo "未找到 ${ENV_FILE}，请先执行 coreman up 生成配置" >&2
    return 1
  fi
  ENV_FILE="$ENV_FILE" KEY="$1" VALUE="$2" python3 - <<'PY'
import os, re
path, key, value = os.environ["ENV_FILE"], os.environ["KEY"], os.environ["VALUE"]
lines = open(path, encoding="utf-8").read().splitlines()
pat = re.compile(rf"^{re.escape(key)}=")
found = False
for i, line in enumerate(lines):
    if pat.match(line):
        lines[i] = f"{key}={value}"; found = True
if not found:
    lines.append(f"{key}={value}")
open(path, "w", encoding="utf-8").write("\n".join(lines) + "\n")
PY
}

pgdata_volume() {  # compose 顶层 name: coreman，COMPOSE_PROJECT_NAME 可覆盖项目名
  echo "${COMPOSE_PROJECT_NAME:-coreman}_pgdata"
}

pgdata_exists() {  # 只读检测数据库数据卷是否已存在（曾初始化过库）；不创建、不删除任何东西
  local volume
  volume="$(pgdata_volume)"
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    echo "docker volume inspect $volume"
    return 1
  fi
  docker volume inspect "$volume" >/dev/null 2>&1
}

ensure_env() {
  local missing="" volume
  [[ -f "$ENV_FILE" ]] || missing="${missing} ${ENV_FILE}"
  [[ -n "$(env_get MASTER_KEY)" ]] || missing="${missing} MASTER_KEY"
  case "$(env_get POSTGRES_PASSWORD)" in "" | change-me) missing="${missing} POSTGRES_PASSWORD" ;; esac
  # 库密码只在数据卷首次初始化时生效，MASTER_KEY 决定库内密文能否解密：已有数据时新生成的值必然对不上。
  if [[ -n "$missing" ]] && pgdata_exists; then
    volume="$(pgdata_volume)"
    {
      echo "检测到已有数据库数据卷 ${volume}，但以下配置缺失、需要新生成：${missing# }。"
      echo "新生成的库密码与 MASTER_KEY 和已有数据不匹配：数据库无法登录，库内加密的凭证也无法解密。未做任何改动。"
      echo "处理方式："
      echo "  - 把原来的配置文件恢复到 ${ENV_FILE}（或用 COREMAN_ENV_FILE 指向它），再执行 coreman up"
      echo "  - 数据卷由手工 docker compose up 初始化过：把当时使用的 POSTGRES_PASSWORD（及 DATABASE_URL）与 MASTER_KEY 填回配置文件"
      echo "  - 确认旧数据不再需要：自行执行 docker volume rm ${volume}（不可恢复，脚本不会代为删除）后再执行 coreman up"
    } >&2
    return 2
  fi
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ROOT/.env.example" "$ENV_FILE"
    echo "已从 .env.example 生成 $ENV_FILE"
  fi
  chmod 600 "$ENV_FILE"  # 内含 MASTER_KEY 与库密码，已存在的文件也一并收紧
  if [[ -z "$(env_get MASTER_KEY)" ]]; then
    env_set MASTER_KEY "$(python3 -c 'import os,base64;print(base64.b64encode(os.urandom(32)).decode())')"
    echo "已生成 MASTER_KEY（请备份，丢失后库内凭证不可解）"
  fi
  if [[ -z "$(env_get SESSION_SECRET)" ]]; then
    env_set SESSION_SECRET "$(python3 -c 'import secrets;print(secrets.token_urlsafe(32))')"
  fi
  if [[ "$(env_get BOOTSTRAP_ADMIN_PASSWORD)" == "change-me" || -z "$(env_get BOOTSTRAP_ADMIN_PASSWORD)" ]]; then
    env_set BOOTSTRAP_ADMIN_PASSWORD "$(python3 -c 'import secrets;print(secrets.token_urlsafe(32))')"
    echo "已生成随机引导管理员密码，请在配置文件中查看"
  fi
  if [[ "$(env_get POSTGRES_PASSWORD)" == "change-me" || -z "$(env_get POSTGRES_PASSWORD)" ]]; then
    local pw
    pw="$(python3 -c 'import secrets;print(secrets.token_hex(16))')"
    env_set POSTGRES_PASSWORD "$pw"
    env_set DATABASE_URL "postgresql+asyncpg://coreman:${pw}@postgres:5432/coreman"
    echo "已生成随机 POSTGRES_PASSWORD 并同步 DATABASE_URL"
  fi
}

wait_healthy() {  # wait_healthy <service> [timeout_s]
  local service="$1" timeout="${2:-180}" cid status i
  [[ "${DRY_RUN:-0}" == "1" ]] && { echo "wait_healthy $service"; return 0; }
  for ((i = 0; i < timeout; i += 3)); do
    cid="$(compose ps -q "$service" 2>/dev/null || true)"
    if [[ -n "$cid" ]]; then
      status="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid")"
      if [[ "$status" == "healthy" || "$status" == "running" ]]; then echo "$service: $status"; return 0; fi
    fi
    sleep 3
  done
  echo "等待 $service 健康超时" >&2
  return 1
}

# ---- 镜像与容器现场 ----

image_tag_of() {  # coreman-api:v2 → v2；registry:5000/coreman-api → latest
  local image="$1" last
  case "$image" in *@*) echo "${image##*@}"; return ;; esac
  last="${image##*/}"
  case "$last" in *:*) echo "${last##*:}" ;; *) echo latest ;; esac
}

is_coreman_image() {
  local name="${1##*/}"
  name="${name%%[:@]*}"
  [[ "$name" == coreman-api || "$name" == coreman-runtime ]]
}

container_images() {  # 每行「服务 镜像 状态 重启策略」，含已停止容器与各 profile 服务
  [[ "${DRY_RUN:-0}" == "1" ]] && return 0
  local ids
  ids="$(compose "${ALL_PROFILES[@]}" ps -a -q 2>/dev/null)" || return 0
  [[ -n "$ids" ]] || return 0
  # shellcheck disable=SC2086  # 容器 ID 按空白拆分为多个参数
  docker inspect --format '{{index .Config.Labels "com.docker.compose.service"}} {{.Config.Image}} {{.State.Status}}{{if .State.Health}}/{{.State.Health.Status}}{{end}} {{.HostConfig.RestartPolicy.Name}}' $ids 2>/dev/null || true
}

report_images() {  # 打印各容器的镜像标签；运行中的 CoreMan 容器标签不一致时提示混版本
  local rows service image state restart tags="" count=0 paused=""
  rows="$(container_images)"
  if [[ -z "$rows" ]]; then
    echo "  （未查询到 CoreMan 容器）"
    return 0
  fi
  printf '  %-18s %-16s %-18s %s\n' 服务 标签 状态 镜像
  while read -r service image state restart; do
    [[ -n "$service" ]] || continue
    printf '  %-18s %-16s %-18s %s\n' "$service" "$(image_tag_of "$image")" "$state" "$image"
    is_coreman_image "$image" || continue
    case "$state" in running*) ;; *) continue ;; esac
    case " $tags " in *" $(image_tag_of "$image") "*) ;; *) tags="$tags $(image_tag_of "$image")"; count=$((count + 1)) ;; esac
    if [[ "$restart" == no && "$service" != migrate && "$service" != operations && "$service" != storage-init ]]; then
      paused="$paused $service"
    fi
  done <<< "$rows"
  if ((count > 1)); then
    echo "警告：运行中的 CoreMan 容器使用了多个镜像标签：${tags# }"
  fi
  if [[ -n "$paused" ]]; then
    echo "注意：以下运行中容器的自动重启已关闭（排空时设置）：${paused# }；确认排空状态后执行 docker update --restart=unless-stopped <容器>"
  fi
}

has_coreman_containers() {
  local rows service image _
  rows="$(container_images)"
  while read -r service image _; do
    [[ -n "$service" ]] && is_coreman_image "$image" && return 0
  done <<< "$rows"
  return 1
}

tag_in_use() {  # tag_in_use <tag>：输出占用原因；部署标签、待定标签或运行中的容器正在使用该标签
  local tag="$1" rows service image state _
  if [[ "$tag" == "$DEPLOYED_TAG" ]]; then echo "部署标签 $TAG_FILE"; return 0; fi
  if [[ "$tag" == "$(read_first_line "$PENDING_FILE")" ]]; then echo "待定升级 $PENDING_FILE"; return 0; fi
  rows="$(container_images)"
  while read -r service image state _; do
    if [[ -z "$service" ]] || ! is_coreman_image "$image"; then continue; fi
    case "$state" in running*) ;; *) continue ;; esac
    if [[ "$(image_tag_of "$image")" == "$tag" ]]; then echo "运行中的 $service"; return 0; fi
  done <<< "$rows"
  return 1
}

report_pg_connections() {
  local out used max pct
  if ! out="$(compose exec -T postgres psql -U coreman -d coreman -At -c \
    "SELECT count(*) FILTER (WHERE backend_type = 'client backend'), current_setting('max_connections') FROM pg_stat_activity" 2>/dev/null)"; then
    echo "PostgreSQL 连接：无法查询（postgres 是否在运行？）"
    return 0
  fi
  out="${out//[[:space:]]/}"
  used="${out%%|*}"
  max="${out##*|}"
  if ! [[ "$used" =~ ^[0-9]+$ && "$max" =~ ^[0-9]+$ ]] || ((max == 0)); then
    echo "PostgreSQL 连接：无法解析查询结果"
    return 0
  fi
  pct=$((used * 100 / max))
  echo "PostgreSQL 连接：${used}/${max}（${pct}%）"
  if ((pct >= 80)); then
    echo "警告：客户端连接已达 max_connections 的 80%，参见 docs/operations.md「数据库连接预算」"
  fi
}

preflight_images() {  # preflight_images <tag>：两种镜像都已在本机才允许动任何容器
  local tag="$1" image missing=""
  for image in "coreman-api:$tag" "coreman-runtime:$tag"; do
    if [[ "${DRY_RUN:-0}" == "1" ]]; then
      echo "docker image inspect $image"
      continue
    fi
    docker image inspect "$image" >/dev/null 2>&1 || missing="$missing $image"
  done
  [[ -n "$missing" ]] || return 0
  {
    echo "镜像预检失败，本机缺少：${missing# }。未改动任何容器或状态文件。"
    echo "处理方式："
    echo "  - 在对应提交上构建：coreman build --tag $tag"
    echo "  - 或拉取发布镜像后改名：docker pull ghcr.io/<owner>/coreman-api:$tag && docker tag ghcr.io/<owner>/coreman-api:$tag coreman-api:${tag}（coreman-runtime 同理）"
    echo "  - 查看本机已有标签：docker image ls coreman-api; docker image ls coreman-runtime"
  } >&2
  return 2
}

# ---- 网关活跃侧 ----

service_running() { [[ -n "$(compose ps -q "$1" 2>/dev/null || true)" ]]; }

recorded_side() {  # recorded_side <platform>：状态文件里的活跃侧，缺失时输出空
  local platform="$1" line
  [[ -f "$GATEWAY_STATE_FILE" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in "$platform=a" | "$platform=b") echo "${line#*=}"; return 0 ;; esac
  done < "$GATEWAY_STATE_FILE"
}

active_side() {  # active_side <platform>：优先状态文件；缺失时 a 未运行且 b 在运行才判为 b
  local platform="$1" side other
  side="$(recorded_side "$platform")"
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    echo "${side:-a}"
    return 0
  fi
  if [[ -z "$side" ]]; then
    if ! service_running "gateway-$platform-a" && service_running "gateway-$platform-b"; then echo b; else echo a; fi
    return 0
  fi
  if [[ "$side" == a ]]; then other=b; else other=a; fi
  if ! service_running "gateway-$platform-$side" && service_running "gateway-$platform-$other"; then
    echo "注意：$GATEWAY_STATE_FILE 记录 $platform 活跃侧为 ${side}，但只有 $other 侧在运行，按 $other 处理" >&2
    side="$other"
  fi
  echo "$side"
}

record_side() {  # record_side <platform> <a|b>：保留其他平台的记录，原子替换状态文件
  local platform="$1" side="$2" content="" p s
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    echo "gateway-active $platform=$side"
    return 0
  fi
  for p in "${GATEWAY_PLATFORMS[@]}"; do
    if [[ "$p" == "$platform" ]]; then s="$side"; else s="$(recorded_side "$p")"; fi
    if [[ -n "$s" ]]; then content="${content}${p}=${s}"$'\n'; fi
  done
  printf '%s' "$content" > "$GATEWAY_STATE_FILE.tmp"
  mv "$GATEWAY_STATE_FILE.tmp" "$GATEWAY_STATE_FILE"
}

# ---- 升级事务：pending → 各步骤 → 提升；失败时 EXIT 钩子输出现场 ----

UPGRADE_ACTIVE=0
UPGRADE_TAG=""
UPGRADE_COMMAND=""

prepare_upgrade_tag() {  # prepare_upgrade_tag [tag]：校验、导出并预检目标标签
  local tag="${1:-}"
  if [[ -n "$tag" ]]; then
    [[ "$tag" =~ $TAG_PATTERN ]] || { echo "镜像标签无效：$tag" >&2; return 2; }
  else
    tag="$(current_tag)"
  fi
  export COREMAN_IMAGE_TAG="$tag"
  UPGRADE_TAG="$tag"
  preflight_images "$tag"
}

begin_upgrade() {  # begin_upgrade <命令描述>：写入 pending，之后的失败都会输出恢复建议
  local previous
  UPGRADE_COMMAND="$1 $UPGRADE_TAG"
  previous="$(read_first_line "$PENDING_FILE")"
  if [[ -n "$previous" ]]; then
    echo "注意：上次升级到 $previous 未完成，本次改为 $UPGRADE_TAG" >&2
  fi
  if [[ "${DRY_RUN:-0}" == "1" ]]; then
    echo "pending $UPGRADE_TAG"
  else
    write_state "$PENDING_FILE" "$UPGRADE_TAG"
  fi
  UPGRADE_ACTIVE=1
  echo "开始：${UPGRADE_COMMAND}（部署标签 ${DEPLOYED_TAG:-未记录}）"
}

finish_upgrade() {
  if [[ "${DRY_RUN:-0}" != "1" ]]; then
    write_state "$TAG_FILE" "$UPGRADE_TAG"
    rm -f "$PENDING_FILE"
  fi
  UPGRADE_ACTIVE=0
  DEPLOYED_TAG="$UPGRADE_TAG"
  echo "完成：${UPGRADE_COMMAND}；部署标签已更新为 $UPGRADE_TAG"
}

report_failed_upgrade() {
  local code="$1"
  {
    echo
    echo "未完成：${UPGRADE_COMMAND}（退出码 ${code}）。"
    echo "已保留 ${PENDING_FILE}（${UPGRADE_TAG}）；部署标签仍为 ${DEPLOYED_TAG:-未记录}。"
    echo "各容器当前实际镜像："
    report_images
    echo "恢复建议："
    echo "  1. coreman logs <服务> 查看失败原因；排空超时表示仍有在途任务，不要删除容器或数据卷。"
    echo "  2. 排除问题后重跑：${UPGRADE_COMMAND}（已就绪的服务会先排空再重建，不会丢在途任务）。"
    if [[ "$UPGRADE_COMMAND" == "coreman upgrade"* && -n "$DEPLOYED_TAG" && "$DEPLOYED_TAG" != "$UPGRADE_TAG" ]]; then
      echo "  3. 放弃本次升级：coreman rollback ${DEPLOYED_TAG}（不回退数据库，仅适用于兼容迁移）。"
    fi
    echo "  4. 确认各服务版本与排空状态后，可手工删除 ${PENDING_FILE}。"
  } >&2
}

on_exit() {
  local code=$?
  set +e
  if [[ "$UPGRADE_ACTIVE" == 1 && "$code" -ne 0 ]]; then
    report_failed_upgrade "$code"
  fi
  exit "$code"
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

check_pending() {  # 有未完成的升级时拒绝整体启动，避免把已升级的服务按旧标签重建
  local force="$1" pending
  pending="$(read_first_line "$PENDING_FILE")"
  [[ -n "$pending" ]] || return 0
  if [[ "$force" == 1 ]]; then
    echo "注意：忽略未完成的升级 ${pending}（--force）" >&2
    return 0
  fi
  {
    echo "存在未完成的升级：${PENDING_FILE}（${pending}），部署标签为 ${DEPLOYED_TAG:-未记录}。"
    echo "整体启动会按部署标签重建服务，可能把已升级的服务拉回旧版本。请先："
    echo "  - 继续升级：coreman upgrade all $pending"
    [[ -z "$DEPLOYED_TAG" ]] || echo "  - 或放弃：coreman rollback $DEPLOYED_TAG"
    echo "  - 或确认各服务版本后删除该文件 / 使用 coreman up --force"
  } >&2
  return 2
}

# ---- 命令 ----

cmd_up() {
  local force=0 arg platform services
  for arg in "$@"; do
    case "$arg" in
      --force) force=1 ;;
      *) echo "未知参数：$arg" >&2; return 2 ;;
    esac
  done
  [[ "$WAIT_TIMEOUT" =~ ^[0-9]+$ ]] || { echo "COREMAN_WAIT_TIMEOUT 须为秒数" >&2; return 2; }
  check_pending "$force"
  ensure_env
  compose up -d postgres
  compose run --rm migrate
  services=("${DEFAULT_SERVICES[@]:1}")
  for platform in "${GATEWAY_PLATFORMS[@]}"; do
    services+=("gateway-$platform-$(active_side "$platform")")
  done
  if ! compose up -d --wait --wait-timeout "$WAIT_TIMEOUT" "${services[@]}"; then
    echo "部分服务未在 ${WAIT_TIMEOUT} 秒内健康：coreman status 查看状态，coreman logs <服务> 查看原因" >&2
    return 1
  fi
  echo "CoreMan 已启动：管理台 $(caddy_base_url)/ ，引导账号见 $ENV_FILE"
}

cmd_down() { compose down "$@"; }

cmd_status() {
  local address url pending platform sides=""
  compose ps
  [[ "${DRY_RUN:-0}" != "1" ]] || return 0
  echo
  echo "镜像标签："
  report_images
  echo "部署标签：${DEPLOYED_TAG:-未记录（使用 .env 的 COREMAN_IMAGE_TAG）}"
  pending="$(read_first_line "$PENDING_FILE")"
  if [[ -n "$pending" ]]; then
    echo "警告：存在未完成的升级（${PENDING_FILE}：${pending}），处理方法见 docs/operations.md"
  fi
  for platform in "${GATEWAY_PLATFORMS[@]}"; do
    sides="$sides $platform=$(active_side "$platform")"
  done
  echo "网关活跃侧：${sides# }"
  report_pg_connections
  address="$(compose port caddy 80)"
  url="${API_HEALTH_URL:-http://127.0.0.1:${address##*:}/health}"
  curl -fsS --max-time 5 "$url" || return 1
  echo
}

cmd_logs() { compose logs -f --tail=200 "$@"; }
cmd_migrate() { compose run --rm migrate; }

worktree_dirty() {
  ! git -C "$ROOT" diff --quiet HEAD -- "${IMAGE_PATHS[@]}" \
    || [[ -n "$(git -C "$ROOT" ls-files --others --exclude-standard -- "${IMAGE_PATHS[@]}")" ]]
}

cmd_build() {
  local tag="" force=0 short="" reason
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tag) [[ $# -ge 2 ]] || { echo "--tag 需要标签参数" >&2; return 2; }; tag="$2"; shift 2 ;;
      --tag=*) tag="${1#--tag=}"; shift ;;
      --force) force=1; shift ;;
      *) echo "未知参数：$1" >&2; return 2 ;;
    esac
  done
  if command -v git >/dev/null && git -C "$ROOT" rev-parse --verify HEAD >/dev/null 2>&1; then
    COREMAN_BUILD_REVISION="$(git -C "$ROOT" rev-parse HEAD)"
    short="$(git -C "$ROOT" rev-parse --short HEAD)"
    if worktree_dirty; then
      COREMAN_BUILD_REVISION="$COREMAN_BUILD_REVISION-dirty"
      short="$short-dirty"
    fi
    export COREMAN_BUILD_REVISION
  fi
  [[ -n "$tag" ]] || tag="${short:-$EXPLICIT_IMAGE_TAG}"
  [[ -n "$tag" ]] || { echo "无法从 Git 推导镜像标签，请用 --tag 指定" >&2; return 2; }
  [[ "$tag" =~ $TAG_PATTERN ]] || { echo "镜像标签无效：$tag" >&2; return 2; }
  if reason="$(tag_in_use "$tag")"; then
    if [[ "$force" != 1 ]]; then
      echo "拒绝覆盖正在使用的镜像标签 ${tag}（${reason}）：覆盖后无法再回退到该版本。请提交后重新构建或用 --tag 指定新标签；确认要覆盖时加 --force。" >&2
      return 2
    fi
    echo "注意：覆盖正在使用的镜像标签 ${tag}（${reason}，--force）" >&2
  fi
  export COREMAN_IMAGE_TAG="$tag"
  compose build migrate worker-a
  echo "已构建 coreman-api:$tag 与 coreman-runtime:$tag"
  if [[ -z "$DEPLOYED_TAG" && -z "$(read_first_line "$PENDING_FILE")" ]] && ! has_coreman_containers; then
    [[ "${DRY_RUN:-0}" == "1" ]] || write_state "$TAG_FILE" "$tag"
    echo "尚无部署记录，已记为部署标签；执行 coreman up 启动"
  else
    echo "滚动升级：coreman upgrade all $tag"
  fi
}

cmd_contact_sync() { compose run --rm migrate /app/.venv/bin/python -m coreman.cli contact-sync "$@"; }

managed_prefix() {
  local service="$1" cid hostname
  if [[ "${DRY_RUN:-0}" == "1" ]]; then echo "$service:dry-run:"; return; fi
  cid="$(compose ps -q "$service")"
  [[ -n "$cid" ]] || return 1
  hostname="$(docker inspect --format '{{.Config.Hostname}}' "$cid")"
  echo "$service:$hostname:"
}

runtime_op() {
  compose run --rm --no-deps --pull never operations /app/.venv/bin/python -m coreman.operations "$@"
}

prepare_stop() {
  local service="$1" cid
  [[ "${DRY_RUN:-0}" == "1" ]] && { echo "disable_restart $service"; return; }
  cid="$(compose ps -q "$service")"
  [[ -z "$cid" ]] || docker update --restart=no "$cid" >/dev/null
}

upgrade_api() {
  compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile
  if [[ "${COREMAN_SKIP_MIGRATION:-0}" != "1" ]]; then compose run --rm --no-deps --pull never migrate; fi
  local s
  for s in api-1 api-2; do compose up -d --no-deps --pull never "$s"; wait_healthy "$s"; done
  # API 只信任 edge 网段转发的客户端地址；Caddy 的网络配置变化时随 API 一并重建，未变化时不做任何事
  compose up -d --no-deps --pull never caddy
}

upgrade_scheduler() {
  compose up -d --no-deps --pull never scheduler
  wait_healthy scheduler
}

upgrade_worker() {
  local side other prefix replacement
  for side in b a; do
    [[ "$side" == b ]] && other=a || other=b
    replacement="$(managed_prefix "worker-$other")"
    runtime_op ready --prefix "$replacement" --timeout 180
    if prefix="$(managed_prefix "worker-$side")"; then
      prepare_stop "worker-$side"
      runtime_op drain --prefix "$prefix" --replacement "$replacement" --timeout 7500
    fi
    compose up -d --force-recreate --no-deps --pull never "worker-$side"
    wait_healthy "worker-$side"
    prefix="$(managed_prefix "worker-$side")"
    runtime_op ready --prefix "$prefix" --timeout 180
  done
}

upgrade_gateway() {  # 在非活跃侧重建新网关，排空活跃侧后切换，并记录新的活跃侧
  local platform="$1" source target prefix replacement
  [[ "$platform" == wecom || "$platform" == feishu ]] || { echo "平台须为 wecom 或 feishu" >&2; return 2; }
  source="$(active_side "$platform")"
  if [[ "$source" == a ]]; then target=b; else target=a; fi
  if prefix="$(managed_prefix "gateway-$platform-$target")"; then
    replacement="$(managed_prefix "gateway-$platform-$source")"
    runtime_op ready --prefix "$replacement" --timeout 180
    prepare_stop "gateway-$platform-$target"
    runtime_op drain --prefix "$prefix" --replacement "$replacement" --timeout 180
    compose stop "gateway-$platform-$target"
  fi
  compose up -d --force-recreate --no-deps --pull never "gateway-$platform-$target"
  wait_healthy "gateway-$platform-$target"
  replacement="$(managed_prefix "gateway-$platform-$target")"
  runtime_op ready --prefix "$replacement" --timeout 180
  if prefix="$(managed_prefix "gateway-$platform-$source")"; then
    prepare_stop "gateway-$platform-$source"
    runtime_op drain --prefix "$prefix" --replacement "$replacement" --timeout 180
    compose stop "gateway-$platform-$source"
  fi
  record_side "$platform" "$target"
}

upgrade_all() {
  local platform
  upgrade_api
  upgrade_scheduler
  upgrade_worker
  for platform in "${GATEWAY_PLATFORMS[@]}"; do upgrade_gateway "$platform"; done
}

cmd_upgrade() {
  local target="${1:-}" tag="${2:-}" platform="" label
  if [[ "$target" == gateway ]]; then platform="${2:-wecom}"; tag="${3:-}"; fi
  [[ -n "$target" ]] || { usage; return 1; }
  case "$target" in
    api|worker|scheduler|all) label="coreman upgrade $target" ;;
    gateway)
      [[ "$platform" == wecom || "$platform" == feishu ]] || { echo "平台须为 wecom 或 feishu" >&2; return 2; }
      label="coreman upgrade gateway $platform" ;;
    *) echo "未知升级目标：$target" >&2; return 1 ;;
  esac
  prepare_upgrade_tag "$tag"
  begin_upgrade "$label"
  case "$target" in
    api) upgrade_api ;;
    worker) upgrade_worker ;;
    scheduler) upgrade_scheduler ;;
    gateway) upgrade_gateway "$platform" ;;
    all) upgrade_all ;;
  esac
  finish_upgrade
}

cmd_rollback() {
  [[ -n "${1:-}" ]] || { echo "请指定保留的镜像标签" >&2; return 2; }
  prepare_upgrade_tag "$1"
  if [[ "${DRY_RUN:-0}" != "1" ]]; then
    local control
    control="$(compose ps -q api-1)"
    [[ -n "$control" ]] || { echo "回退需要一个运行中的当前 API 作为排空控制工具" >&2; return 2; }
    COREMAN_OPERATIONS_IMAGE="$(docker inspect --format '{{.Image}}' "$control")"
    export COREMAN_OPERATIONS_IMAGE
  fi
  export COREMAN_SKIP_MIGRATION=1
  begin_upgrade "coreman rollback"
  upgrade_all
  finish_upgrade
}

usage() {
  cat <<'EOF'
用法: coreman <命令> [参数]
  up [--force]                首次或整体启动并等待健康（自动补全 .env 的密钥；按记录的活跃侧拉起网关；有未完成升级时拒绝）
  down [-t 秒]                停止并删除容器（保留数据卷；worker 可能等待在途任务最长 2 小时）
  status                      容器状态、各容器镜像标签、网关活跃侧、PostgreSQL 连接数与 api 健康
  logs [service…]             跟踪日志
  migrate                     执行数据库迁移
  build [--tag 标签] [--force]  构建两个镜像；默认标签为 Git 短提交（未提交改动加 -dirty），拒绝覆盖正在使用的标签
  upgrade <api|worker|scheduler|all> [tag]  预检镜像后按目标滚动升级（失败立即停止并保留待定标签）
  upgrade gateway <wecom|feishu> [tag]      网关 a/b 排空接管，并记录新的活跃侧
  rollback <tag>              回退到保留的镜像标签，不回退数据库
  skills sync URL --source KEY 同步已登记的技能目录
  contact-sync [--app 名称]     同步企业微信通讯录
  help                        本说明
环境变量: DRY_RUN=1 只打印 compose 命令；COREMAN_ENV_FILE 指定 .env 路径；COREMAN_IMAGE_TAG 覆盖部署标签；
  COREMAN_WAIT_TIMEOUT 为 up 等待健康的秒数（默认 300）；COREMAN_STATE_DIR 为状态文件目录（默认仓库根目录）
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    up) cmd_up "$@" ;;
    rollback) cmd_rollback "$@" ;;
    down) cmd_down "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    migrate) cmd_migrate "$@" ;;
    build) cmd_build "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    skills) compose run --rm migrate /app/.venv/bin/python -m coreman.cli skills "$@" ;;
    contact-sync) cmd_contact_sync "$@" ;;
    help|-h|--help) usage ;;
    *) usage; return 1 ;;
  esac
}

main "$@"
